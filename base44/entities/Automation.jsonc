{
  "name": "Automation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "instruction": {
      "type": "string"
    },
    "cadence": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "run_hour": {
      "type": "number",
      "default": 9
    },
    "run_day": {
      "type": "number",
      "default": 1
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_task_id": {
      "type": "string"
    },
    "last_task_url": {
      "type": "string"
    },
    "run_count": {
      "type": "number",
      "default": 0
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "at"
        ]
      }
    }
  },
  "required": [
    "title",
    "instruction"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}