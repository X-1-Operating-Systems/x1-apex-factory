{
  "name": "BridgeEvent",
  "type": "object",
  "properties": {
    "action": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ],
      "default": "in"
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "type": "number"
    },
    "ms": {
      "type": "number"
    },
    "detail": {
      "type": "string",
      "maxLength": 300
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "action",
    "direction",
    "ok"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}