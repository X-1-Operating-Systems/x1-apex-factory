{
  "name": "BrowserHostConfig",
  "type": "object",
  "properties": {
    "host_url": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "environment_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "volume_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "provisioned",
        "deploying",
        "healthy",
        "failed"
      ],
      "default": "provisioned"
    },
    "last_deploy_id": {
      "type": "string"
    },
    "last_deploy_status": {
      "type": "string"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "host_url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}