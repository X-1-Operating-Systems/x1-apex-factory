{
  "name": "Deployment",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "enum": [
        "vercel",
        "railway",
        "docker",
        "github_pages"
      ],
      "default": "vercel"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready_for_approval",
        "approved",
        "blocked",
        "superseded"
      ],
      "default": "blocked"
    },
    "manifest_hash": {
      "type": "string"
    },
    "page_version": {
      "type": "number"
    },
    "qa_score": {
      "type": "number"
    },
    "qa_verdict": {
      "type": "string",
      "enum": [
        "pass",
        "review",
        "block"
      ]
    },
    "url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "status"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "file_uri"
        ]
      }
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "project_name",
    "target",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}