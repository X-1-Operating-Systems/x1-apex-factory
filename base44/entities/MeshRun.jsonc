{
  "name": "MeshRun",
  "type": "object",
  "properties": {
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "ok": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "score": {
      "type": "number"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "label",
          "ok"
        ]
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "at",
    "ok",
    "total",
    "score"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}