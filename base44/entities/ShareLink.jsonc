{
  "name": "ShareLink",
  "type": "object",
  "properties": {
    "token": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "deployment_id": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ]
      }
    },
    "website_id": {
      "type": "string"
    },
    "site_title": {
      "type": "string"
    },
    "site_url": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "access": {
      "type": "string",
      "enum": [
        "view"
      ],
      "default": "view"
    },
    "password_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}