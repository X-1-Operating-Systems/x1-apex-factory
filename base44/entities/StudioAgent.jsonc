{
  "name": "StudioAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "run_count": {
      "type": "number",
      "default": 0
    },
    "last_task_id": {
      "type": "string"
    },
    "last_task_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "instructions"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}