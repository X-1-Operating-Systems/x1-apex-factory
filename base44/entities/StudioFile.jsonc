{
  "name": "StudioFile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size": {
      "type": "number"
    },
    "task_id": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "task",
        "studio",
        "library"
      ],
      "default": "task"
    }
  },
  "required": [
    "name",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}