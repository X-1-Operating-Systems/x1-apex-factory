{
  "name": "Template",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "saas",
        "agency",
        "local_service",
        "restaurant",
        "portfolio",
        "commerce",
        "real_estate",
        "clinic",
        "fitness",
        "professional",
        "event",
        "editorial"
      ]
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accent": {
      "type": "string"
    },
    "surface": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light"
    },
    "headline_font": {
      "type": "string",
      "enum": [
        "serif",
        "sans",
        "display"
      ],
      "default": "serif"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "props": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "type"
        ]
      }
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}