{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "automation_clock",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_due_automations": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAutomations",
            "args": {
              "mode": "due"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run due automations",
            "description": "Launches enabled automations due this hour"
          }
        }
      }
    ]
  },
  "name": "Automation Clock",
  "description": "Every hour, launches any due agent automations as Manus tasks.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}