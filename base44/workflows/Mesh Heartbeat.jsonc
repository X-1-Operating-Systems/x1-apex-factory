{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Mesh Heartbeat",
  "description": "Every 15 minutes, asks every wired system for an answer and records the result, so the mesh has a history instead of an opinion.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "mesh_heartbeat",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "beat": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "meshStatus",
            "args": {
              "action": "beat"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Probe the mesh",
            "description": "Every node, both directions"
          }
        }
      }
    ]
  }
}